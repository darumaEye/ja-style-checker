# OS生成ファイル
.DS_Store

# Python実行時のキャッシュ
__pycache__/
*.pyc

# Python仮想環境
.venv/

# 作業用スクラッチディレクトリ（.gitkeepだけは追跡してディレクトリ自体を残す）
workings/*
!workings/.gitkeep

# Claude Codeのローカル設定
.claude/settings.local.json

# ルールの一次資料（要領原本のPDF、社内規程等）の保管先。
# 文化庁公開のPDFは再取得できるため、社内規程等は社外に出すべきでないため、
# いずれもリポジトリには含めない。
source-materials/*
!source-materials/.gitkeep

# ビルド生成物
# package.sh で再生成できるため不要。
dist/
